# Supabase/Neon PostgreSQL connection string
# ตัวอย่าง Neon:     postgresql://[user]:[password]@ep-xxx.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/dbname

# พอร์ตของเว็บ (default 3000) — บน platform ส่วนใหญ่ตัว platform จะตั้ง PORT ให้เอง
PORT=3000

# ชื่อร้าน (แสดงในหน้าเว็บ)
SHOP_NAME=ร้านข้าวเที่ยง

# 🔒 รหัสผ่านสำหรับแก้ไข QR / ชื่อผู้รับเงิน
# **ตั้งค่าก่อน deploy เสมอ** — ถ้าไม่ตั้ง ใครเข้าเว็บก็จะแก้ QR ได้
# ใส่ค่าที่เดายาก (เช่น UUID หรือ random 16 ตัวอักษร)
ADMIN_PASSWORD=
